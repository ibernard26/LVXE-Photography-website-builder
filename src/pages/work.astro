---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import SeriesIndex from '@/components/SeriesIndex.astro';
import Plate from '@/components/Plate.astro';
import { chapters, frameOf, plateNumber } from '@/data/plates';
import Film from '@/components/Film.astro';
import { filmFrame, filmNumber, films } from '@/data/films';
import { link } from '@/lib/link';

const pad = (n: number) => String(n).padStart(2, '0');
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
---

<BaseLayout title="Work" label="Issue 01 / Work">
  <PageHead
    number="No. 02"
    section="Work"
    title="Work"
    counter="Series, Plates & Film."
    lede="Bodies of work are catalogued as series. Every photograph hangs as a plate and every moving piece screens as a film, whole and at the ratio it was made."
  />

  <SeriesIndex heading="Catalogue" withConcepts linked={false} />

  <!-- Chapters: the archive by subject, light and dark walls in turn. Each
       plate hangs whole at its native ratio in a column flow, so frames of
       any shape sit together without cropping. -->
  <div id="plates" class="mt-28 scroll-mt-8 sm:mt-40">
    {
      chapters.map((chapter, i) => (
        <section
          id={chapter.slug}
          aria-labelledby={`chapter-${chapter.slug}`}
          class:list={['scroll-mt-8 py-20 sm:py-28', i % 2 === 0 && 'wall']}
        >
          <div class="mx-auto max-w-screen-2xl px-gutter">
            <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-border pb-6">
              <h2 id={`chapter-${chapter.slug}`} class="text-display text-[clamp(2.5rem,6vw,5.5rem)]">
                <span class="text-meta mb-4 block">Chapter {roman[i]}</span>
                {chapter.name}
              </h2>
              <p class="text-meta">
                {pad(chapter.plates.length)} {chapter.plates.length === 1 ? 'plate' : 'plates'}
              </p>
            </div>
            <div class="chapter-wall mt-12 sm:mt-16">
              {chapter.plates.map((plate) => (
                <div class="chapter-item">
                  <Plate
                    plate={plate}
                    href={link(`/work/${plate.id}`)}
                    transitionName={`plate-${plate.id}`}
                    label={`Pl. ${plateNumber(plate)}`}
                    note={`${plate.tone} · ${frameOf(plate).ratio}`}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, calc(100vw - 2rem)"
                  />
                </div>
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <!-- Films: moving pieces, each screened at its native ratio. -->
  <section id="films" aria-labelledby="films-title" class="mx-auto mt-28 max-w-screen-2xl scroll-mt-8 px-gutter sm:mt-40">
    <div class="grid grid-cols-12 items-end gap-x-4 gap-y-6 border-b border-border pb-6 lg:gap-x-8">
      <h2 id="films-title" class="reveal-lines col-span-12 sm:col-span-8">
        <span class="line-mask"><span class="text-display">Film</span></span>
      </h2>
      <p class="text-meta col-span-12 sm:col-span-4 sm:text-right">
        {String(films.length).padStart(2, '0')} {films.length === 1 ? 'piece' : 'pieces'} · silent, looping
      </p>
    </div>

    <div class="mt-16 grid grid-cols-12 gap-x-4 gap-y-16 lg:gap-x-8">
      {
        films.map((film) => (
          <div class="col-span-12 grid grid-cols-12 items-end gap-x-4 gap-y-8 lg:gap-x-8">
            <div class="col-span-8 sm:col-span-5 lg:col-span-4">
              <Film
                film={film}
                transitionName={`film-${film.id}`}
                label={`Film ${filmNumber(film)}`}
                note={`${filmFrame(film).ratio} · ${filmFrame(film).runtime}`}
              />
            </div>
            <div class="col-span-12 sm:col-span-6 sm:col-start-7 lg:col-span-5 lg:col-start-7">
              <p class="text-meta">{film.tone} · {filmFrame(film).orientation} · loop</p>
              <h3 class="text-heading mt-4">{film.title ?? 'Untitled'}</h3>
              <p class="text-body mt-4 max-w-measure">{film.description}</p>
              <a href={link(`/film/${film.id}`)} class="text-meta link-quiet mt-8 inline-block text-bone">Enter the film room</a>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
