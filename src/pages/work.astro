---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import SeriesIndex from '@/components/SeriesIndex.astro';
import GalleryWall from '@/components/GalleryWall.astro';
---

<BaseLayout title="Work" label="Issue 01 / Work">
  <PageHead
    number="No. 02"
    section="Work"
    title="Work"
    counter="series & plates."
    lede="Bodies of work are catalogued as series. Every photograph hangs below as a plate, whole and at the ratio it was made."
  />

  <SeriesIndex heading="Catalogue" withConcepts linked={false} />

  <div id="plates" class="mt-28 scroll-mt-8 sm:mt-40">
    <GalleryWall heading="The wall" intro="Select a plate to enter its room." />
  </div>
</BaseLayout>
