---
/**
 * Film room — one moving-image piece, screened like a room of the homepage
 * exhibition: the film as tall as the window allows at its native ratio,
 * with a pause/play control, and the wall label beside it. Shares the plate
 * rooms' structure.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Film from '@/components/Film.astro';
import { filmFrame, filmNumber, films, type Film as FilmT } from '@/data/films';
import { series } from '@/data/series';
import { site } from '@/data/site';

export const getStaticPaths = (() => films.map((film) => ({ params: { film: film.id }, props: { film } }))) satisfies GetStaticPaths;

interface Props {
  film: FilmT;
}

const { film } = Astro.props;
const no = filmNumber(film);
const total = String(films.length).padStart(2, '0');
const { orientation, ratio, runtime } = filmFrame(film);
const r = film.width / film.height;
const seriesTitle = film.series ? series.find((s) => s.slug === film.series)?.title : undefined;
import { link } from '@/lib/link';
---

<BaseLayout
  title={`Film ${no}${film.title ? ` — ${film.title}` : ''}`}
  description={`Film ${no} from the LVXE archive by ${site.artist}. ${film.description}`}
  label={`Film ${no} of ${total}`}
>
  <article aria-labelledby="film-title" class="room bg-obsidian" data-label-in>
    <div class="room-inner lg:grid-cols-[auto_minmax(0,20rem)] lg:justify-center">
      <div class="flex justify-center">
        <div class="hang" style={`--r: ${r.toFixed(4)}`}>
          <Film film={film} reveal={false} priority transitionName={`film-${film.id}`} />
        </div>
      </div>

      <div class="wall-label lg:self-end">
        <p class="text-meta">Film {no} of {total} · Moving portrait</p>
        <h1 id="film-title" class="text-heading mt-4 text-[clamp(1.75rem,2.6vw,2.5rem)] lg:mt-6">
          {film.title ?? 'Untitled'}<span class="sr-only">, film {no}</span>
        </h1>
        <dl class="mt-6 grid grid-cols-[5.5rem_minmax(0,1fr)] gap-y-2 border-t border-border pt-4">
          <dt class="text-meta">Artist</dt>
          <dd class="text-meta text-bone">{site.artist}</dd>
          {seriesTitle && (<><dt class="text-meta">Series</dt><dd class="text-meta text-bone">{seriesTitle}</dd></>)}
          <dt class="text-meta">Medium</dt>
          <dd class="text-meta text-bone">Moving image, {film.tone.toLowerCase()}, silent{film.loop ? ' loop' : ''}</dd>
          <dt class="text-meta">Frame</dt>
          <dd class="text-meta text-bone">{orientation}, {ratio}, uncropped</dd>
          <dt class="text-meta">Runtime</dt>
          <dd class="text-meta text-bone tabular-nums">{runtime}</dd>
        </dl>
        <p class="text-body mt-6 max-w-[36ch] text-[0.875rem] leading-[1.55]">{film.description}</p>
        <a href={link('/work#films')} class="text-meta link-quiet mt-6 text-bone">Back to the work</a>
      </div>
    </div>
  </article>
</BaseLayout>
