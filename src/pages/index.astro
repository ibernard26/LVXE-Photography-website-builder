---
/**
 * Home — Issue 01. Rhythm: dark strip → staggered intro → cinema band →
 * series catalogue → light gallery wall (feature + diptych) → commercial
 * scope → booking. Each photograph appears once on the page: the hero holds
 * plates 01, 03 and 04; the wall holds 02, 05 and 06.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroStrip from '@/components/HeroStrip.astro';
import CinemaFrame from '@/components/CinemaFrame.astro';
import SeriesIndex from '@/components/SeriesIndex.astro';
import GalleryWall from '@/components/GalleryWall.astro';
import { plates } from '@/data/plates';
import { films } from '@/data/films';
import { commercial } from '@/data/commissions';
import { issue, site } from '@/data/site';

const [l1, l2, l3] = site.slogan.lines;
---

<BaseLayout label="Issue 01 / Index">
  <HeroStrip />

  <!-- Staggered introduction: grotesk and italic lines on offset columns. -->
  <section aria-labelledby="intro-title" class="mx-auto mt-28 max-w-screen-2xl px-gutter sm:mt-40">
    <div class="grid grid-cols-12 gap-x-4 gap-y-12 lg:gap-x-8">
      <p class="text-meta col-span-12 lg:col-span-2">No. {issue.number}<br />Introduction</p>

      <h2 id="intro-title" class="reveal-lines col-span-12 lg:col-span-10" data-draft={site.slogan.draft || undefined}>
        <span class="line-mask"><span class="text-display" style="--i:0">{l1}</span></span>{' '}
        <span class="line-mask pl-[18%] sm:pl-[24%]"><span class="text-display-serif" style="--i:1">{l2}</span></span>{' '}
        <span class="line-mask pl-[42%] sm:pl-[52%]">
          <span class="text-display" style="--i:2">{l3}<span class="text-burgundy">.</span></span>
        </span>
      </h2>

      <div class="col-span-12 grid gap-y-8 sm:col-span-8 sm:col-start-5 lg:col-span-4 lg:col-start-7">
        <p class="text-body reveal-fade text-[1.0625rem] text-bone" data-draft={site.proposition.draft || undefined}>
          {site.proposition.text}
        </p>
        <ul class="reveal-fade flex flex-wrap gap-x-10 gap-y-4" style="--i:1">
          <li><a href="/work" class="text-meta link-quiet text-bone">View the work</a></li>
          <li><a href="/book" class="text-meta link-book">Book a session</a></li>
        </ul>
      </div>
    </div>
  </section>

  <div class="mt-28 sm:mt-40">
    <CinemaFrame film={films[0]} line="A moving portrait." />
  </div>

  <div class="mt-28 sm:mt-40">
    <SeriesIndex />
  </div>

  <div class="mt-28 sm:mt-40">
    <GalleryWall
      heading="Plates"
      intro="Every frame is shown whole, at the ratio it was made. Select a plate to enter its room."
      blocks={[
        { kind: 'feature', plate: plates.earringPortrait, aside: plates.meshPair },
        {
          kind: 'diptych',
          plate: plates.recordStore,
          side: 'right',
          eyebrow: 'Diptych — Monochrome',
          heading: 'In Monochrome.',
          text: plates.recordStore.alt,
        },
      ]}
    />
  </div>

  <!-- Commercial pathway: clearly separated from the editorial sequence. -->
  <section aria-labelledby="commercial-title" class="mx-auto mt-28 max-w-screen-2xl px-gutter sm:mt-40">
    <div class="grid grid-cols-12 gap-x-4 gap-y-10 border-t border-border pt-10 lg:gap-x-8">
      <p class="text-meta col-span-12 lg:col-span-2">For brands<br />&amp; companies</p>
      <h2 id="commercial-title" class="reveal-lines col-span-12 lg:col-span-10">
        <span class="line-mask"><span class="text-display" style="--i:0">Commercial</span></span>{' '}
        <span class="line-mask"><span class="text-display-serif" style="--i:1">Commissions.</span></span>
      </h2>
      <div class="col-span-12 lg:col-span-6 lg:col-start-7">
        <ul class="border-t border-border">
          {commercial.map((c, i) => (
            <li class="reveal-fade flex items-baseline justify-between gap-6 border-b border-border py-4" style={`--i:${i}`}>
              <span class="text-heading text-[1.25rem]">{c}</span>
              <span class="text-meta">0{i + 1}</span>
            </li>
          ))}
        </ul>
        <p class="text-body mt-8 max-w-measure">
          Campaigns, workplace portraiture and events are quoted per project. Send the brief, dates and usage to
          start the conversation.
        </p>
        <a href="/book?type=commercial" class="text-meta link-book mt-8 inline-block">Send a commercial brief</a>
        <a href="/commissions" class="text-meta link-quiet mt-8 ml-10 inline-block">Both scopes</a>
      </div>
    </div>
  </section>
</BaseLayout>
