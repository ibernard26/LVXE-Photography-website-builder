---
import Layout from '@/layouts/Layout.astro';
import { site } from '@/data/site';

const { email } = site.contact;

const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT as string | undefined;
const ready = typeof endpoint === 'string' && /^https:\/\/formspree\.io\/f\/[A-Za-z0-9]+$/.test(endpoint);

const clientTypes = ['Individual', 'Creative / talent', 'Brand', 'Agency', 'Corporate', 'Other'];
const categories = [
  { value: 'fashion', label: 'Fashion' },
  { value: 'portraits', label: 'Portraits' },
  { value: 'creative', label: 'Creative' },
  { value: 'commercial', label: 'Commercial' },
];
// Approved by owner. These are QUALIFICATION RANGES for routing inquiries,
// not package prices. Do not publish them as pricing anywhere else on the site.
const budgets = ['Under $500', '$500–$999', '$1,000–$1,999', '$2,000–$4,999', '$5,000+', 'Budget to be discussed'];
const today = new Date().toISOString().slice(0, 10);
---

<Layout title="Inquire" description="Inquire about a portrait, fashion, creative or commercial commission with LVXE.">
  <section class="mx-auto max-w-screen-2xl px-gutter pt-16 sm:pt-24">
    <h1 class="text-display">Inquire</h1>
    <p class="text-body mt-8 max-w-measure">{site.inquiryIntro}</p>

    {!ready && (
      <p role="status" class="text-meta mt-8 border border-burgundy p-4 max-w-measure">
        The form is not connected yet. Please email <a href={`mailto:${email}?subject=LVXE%20inquiry`} class="link-quiet text-bone normal-case tracking-normal">{email}</a> with your project details.
      </p>
    )}

    <form action={ready ? endpoint : undefined} method="POST" class="mt-12 grid max-w-2xl gap-8" aria-describedby="required-note">
      <p id="required-note" class="text-meta">All fields marked * are required.</p>
      <input type="hidden" name="_subject" value="New LVXE inquiry" />

      <div class="grid gap-8 sm:grid-cols-2">
        <label class="text-meta">Name *
          <input class="field" name="name" required minlength="2" maxlength="120" autocomplete="name" />
        </label>
        <label class="text-meta">Email *
          <input class="field" type="email" name="_replyto" required maxlength="200" autocomplete="email" />
        </label>
      </div>

      <div class="grid gap-8 sm:grid-cols-2">
        <label class="text-meta">Client type *
          <select class="field" name="client_type" required>
            <option value="">Select…</option>
            {clientTypes.map((c) => <option>{c}</option>)}
          </select>
        </label>
        <label class="text-meta">Category *
          <select class="field" name="category" required>
            <option value="">Select…</option>
            {categories.map((c) => <option value={c.value}>{c.label}</option>)}
          </select>
        </label>
      </div>

      <fieldset class="grid gap-8 sm:grid-cols-2">
        <legend class="text-meta mb-2">Date window (optional)</legend>
        <label class="text-meta">Earliest
          <input class="field" type="date" name="date_from" min={today} />
        </label>
        <label class="text-meta">Latest
          <input class="field" type="date" name="date_to" min={today} />
        </label>
      </fieldset>

      <label class="text-meta">Budget bracket *
        <select class="field" name="budget" required aria-describedby="budget-hint">
          <option value="">Select…</option>
          {budgets.map((b) => <option>{b}</option>)}
        </select>
        <span id="budget-hint" class="mt-2 block normal-case tracking-normal">A guide range to help scope the project, not a package price.</span>
      </label>

      <label class="text-meta">Brief *
        <textarea class="field" name="brief" rows="7" required minlength="20" maxlength="5000"
          aria-describedby="brief-hint"></textarea>
        <span id="brief-hint" class="mt-2 block normal-case tracking-normal">Concept, location, usage, and any references.</span>
      </label>

      <!-- Honeypot: Formspree discards submissions where _gotcha is filled. -->
      <div class="hidden" aria-hidden="true">
        <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>

      <button type="submit" disabled={!ready}
        class="text-meta justify-self-start border border-bone px-6 py-3 text-bone transition-colors duration-200 hover:bg-bone hover:text-obsidian disabled:cursor-not-allowed disabled:opacity-50">
        Send inquiry
      </button>
    </form>
  </section>

  <script is:inline>
    // Keep "Latest" >= "Earliest".
    (() => {
      const f = document.querySelector('input[name="date_from"]');
      const t = document.querySelector('input[name="date_to"]');
      f?.addEventListener('change', () => { if (t) t.min = f.value; });
    })();
  </script>
</Layout>
