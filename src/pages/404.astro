---
/**
 * Not found. Static hosts serve this for any unknown path; it keeps the
 * masthead and menu so the visitor can continue from here.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
---

<BaseLayout title="Not found" label="Issue 01 / Not found" hideBooking description="This page is not part of the LVXE archive.">
  <PageHead
    number="404"
    section="Not found"
    title="Not on"
    counter="the wall."
    lede="This address is not part of the archive. The index and the ledger list every published work."
  />
  <div class="mx-auto flex max-w-screen-2xl flex-wrap gap-x-10 gap-y-4 px-gutter">
    <a href="/" class="text-meta link-quiet text-bone">Index</a>
    <a href="/?view=ledger" class="text-meta link-quiet text-bone">Ledger</a>
    <a href="/book" class="text-meta link-book">Book</a>
  </div>
</BaseLayout>
