---
/**
 * Plate exhibition room — one real photograph per page, hung like a single
 * work in a dark gallery: the frame at native ratio (max 86vh), a wall label
 * with only verified facts, and the neighbouring plates as small frames that
 * morph into this room's position when followed (shared-element view
 * transitions). Series rooms will reuse this template once plates are
 * assigned to series.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Plate from '@/components/Plate.astro';
import { frameOf, plateList, plateNumber, type Plate as PlateT } from '@/data/plates';
import { site } from '@/data/site';
import { series } from '@/data/series';

export const getStaticPaths = (() =>
  plateList.map((plate, i) => ({
    params: { plate: plate.id },
    props: {
      plate,
      prev: plateList[(i - 1 + plateList.length) % plateList.length],
      next: plateList[(i + 1) % plateList.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  plate: PlateT;
  prev: PlateT;
  next: PlateT;
}

const { plate, prev, next } = Astro.props;
const no = plateNumber(plate);
const total = String(plateList.length).padStart(2, '0');
const { orientation, ratio } = frameOf(plate);
const r = plate.image.width / plate.image.height;
const seriesTitle = plate.series ? series.find((s) => s.slug === plate.series)?.title : undefined;
---

<BaseLayout
  title={`Plate ${no}${plate.title ? ` — ${plate.title}` : ''}`}
  description={`Plate ${no} from the LVXE archive by ${site.artist}. ${plate.alt}`}
  label={`Plate ${no} of ${total}`}
>
  <article aria-labelledby="plate-title" class="mx-auto max-w-screen-2xl px-gutter">
    <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-border pt-6 pb-4">
      <a href="/work#plates" class="text-meta link-quiet">Back to the wall</a>
      <p class="text-meta">Plate {no} of {total}</p>
    </div>

    <!-- The room: frame centred, sized by height, native ratio. -->
    <div class="flex justify-center pt-10 sm:pt-16">
      <div class="w-full" style={`max-width: calc(86vh * ${r.toFixed(4)})`}>
        <Plate
          plate={plate}
          priority
          reveal={false}
          transitionName={`plate-${plate.id}`}
          sizes="(min-width: 1024px) 58vh, 100vw"
        />
      </div>
    </div>

    <!-- Wall label -->
    <div class="mt-16 grid grid-cols-12 gap-x-4 gap-y-10 border-t border-border pt-10 sm:mt-24 lg:gap-x-8">
      <p aria-hidden="true" class="reveal-lines col-span-12 lg:col-span-5">
        <span class="line-mask">
          <span class="block font-sans text-[clamp(7rem,22vw,20rem)] font-[800] leading-[0.78] tracking-[-0.07em] text-charcoal" style="--i:0">
            {no}
          </span>
        </span>
      </p>

      <div class="col-span-12 lg:col-span-6 lg:col-start-7">
        <h1 id="plate-title" class="text-display-serif text-[clamp(2.5rem,5vw,4.5rem)]">
          {plate.title ?? 'Untitled'}<span class="sr-only">, plate {no}</span>
        </h1>
        <dl class="mt-10 grid grid-cols-[8rem_minmax(0,1fr)] gap-y-3 border-t border-border pt-6">
          <dt class="text-meta">Artist</dt>
          <dd class="text-body text-bone">{site.artist}</dd>
          {seriesTitle && (<><dt class="text-meta">Series</dt><dd class="text-body text-bone">{seriesTitle}</dd></>)}
          <dt class="text-meta">Tone</dt>
          <dd class="text-body text-bone">{plate.tone}</dd>
          <dt class="text-meta">Frame</dt>
          <dd class="text-body text-bone">{orientation}, {ratio}, shown uncropped</dd>
        </dl>
        <p class="text-body mt-8 max-w-[52ch]">{plate.caption ?? plate.alt}</p>
      </div>
    </div>

    <!-- Neighbouring rooms -->
    <nav aria-label="More plates" class="mt-24 grid grid-cols-2 gap-x-4 border-t border-border pt-8 sm:mt-32 lg:gap-x-8">
      {
        [
          { p: prev, dir: 'Previous' },
          { p: next, dir: 'Next' },
        ].map(({ p, dir }) => (
          <a
            href={`/work/${p.id}`}
            class:list={['group flex items-end gap-4 sm:gap-6', dir === 'Next' && 'flex-row-reverse text-right']}
          >
            <div class="w-20 shrink-0 sm:w-28" transition:name={`plate-${p.id}`}>
              <Plate plate={p} reveal={false} sizes="112px" />
            </div>
            <span>
              <span class="text-meta block">{dir}</span>
              <span class="text-heading mt-2 block transition-transform duration-500 ease-editorial group-hover:-translate-y-1">
                Plate {plateNumber(p)}
              </span>
            </span>
          </a>
        ))
      }
    </nav>
  </article>
</BaseLayout>
