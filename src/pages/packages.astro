---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import { commercial, onRequest, sessionPackages } from '@/data/packages';
import { site } from '@/data/site';

const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="Packages"
  label="Issue 01 / Packages"
  description={`Portrait and editorial session packages with LVXE across ${site.region}.`}
>
  <PageHead
    number="No. 03"
    section="Packages"
    title="Rates"
    counter="in plain view."
    lede={`Portrait and editorial sessions for models and creatives across ${site.region}.`}
  />

  <!-- Rate index on a light gallery wall. -->
  <section aria-labelledby="sessions" class="wall py-20 sm:py-32">
    <div class="mx-auto grid max-w-screen-2xl grid-cols-12 gap-x-4 gap-y-10 px-gutter lg:gap-x-8">
      <h2 id="sessions" class="text-meta col-span-12 text-bone lg:col-span-2">Sessions</h2>

      <div class="col-span-12 lg:col-span-10">
        <table class="w-full border-collapse">
          <caption class="sr-only">Session packages and prices</caption>
          <thead>
            <tr class="border-b border-bone">
              <th scope="col" class="text-meta w-16 pb-4 text-left font-normal">No.</th>
              <th scope="col" class="text-meta pb-4 text-left font-normal">Package</th>
              <th scope="col" class="text-meta pb-4 text-right font-normal">Rate</th>
            </tr>
          </thead>
          <tbody>
            {
              sessionPackages.map((p, i) => (
                <tr class="reveal-fade border-b border-border" style={`--i:${i}`}>
                  <td class="text-meta py-7 align-top sm:py-10">{pad(i + 1)}</td>
                  <th scope="row" class="py-7 pr-6 text-left font-normal sm:py-10">
                    <span class="block font-sans text-[clamp(1.75rem,4.5vw,3.75rem)] font-[500] leading-none tracking-[-0.04em]">
                      {p.name}
                    </span>
                    <span class="text-meta mt-3 block">{p.detail}</span>
                  </th>
                  <td class="py-7 text-right align-top font-sans text-[clamp(1.75rem,4.5vw,3.75rem)] font-[300] leading-none tracking-[-0.04em] tabular-nums sm:py-10">
                    {p.price === null ? 'On request' : usd.format(p.price)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>

        <p class="text-body mt-8">Also available, rate on request: {onRequest.join(', ').toLowerCase()}.</p>
        <a href="/book?type=portrait" class="text-meta link-book mt-8 inline-block">Book a portrait session</a>
      </div>
    </div>
  </section>

  <!-- Commercial: a separate, darker door. -->
  <section aria-labelledby="commercial" class="mx-auto mt-28 max-w-screen-2xl px-gutter sm:mt-40">
    <div class="grid grid-cols-12 gap-x-4 gap-y-10 lg:gap-x-8">
      <p class="text-meta col-span-12 lg:col-span-2">For brands<br />&amp; companies</p>
      <h2 id="commercial" class="reveal-lines col-span-12 lg:col-span-10">
        <span class="line-mask"><span class="text-display" style="--i:0">Commercial</span></span>
        <span class="line-mask pl-[20%]"><span class="text-display-serif" style="--i:1">quoted per brief.</span></span>
      </h2>
      <ul class="col-span-12 border-t border-border lg:col-span-6 lg:col-start-7">
        {
          commercial.map((c, i) => (
            <li class="reveal-fade flex items-baseline justify-between gap-6 border-b border-border py-4" style={`--i:${i}`}>
              <span class="text-heading text-[1.25rem]">{c}</span>
              <span class="text-meta">{pad(i + 1)}</span>
            </li>
          ))
        }
      </ul>
      <div class="col-span-12 lg:col-span-6 lg:col-start-7">
        <p class="text-body max-w-measure">
          Send the brief, dates, deliverables and usage. Campaign, workplace and event work is scoped and quoted for each
          project.
        </p>
        <a href="/book?type=commercial" class="text-meta link-book mt-8 inline-block">Send a commercial brief</a>
      </div>
    </div>
  </section>
</BaseLayout>
