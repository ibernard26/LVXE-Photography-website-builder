---
import type { ImageMetadata } from 'astro';
import Document from '@/layouts/Document.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BookingBand from '@/components/BookingBand.astro';

interface Props {
  title?: string;
  description?: string;
  /** Spine label in the right margin, e.g. "Work / Plate 03". */
  label?: string;
  /** Hide the closing booking band (used on /book itself). */
  hideBooking?: boolean;
  /** Photograph for the link preview. Falls back to the exhibition lead. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, description, label = 'Issue 01', hideBooking = false, image, imageAlt } = Astro.props;
---

<Document title={title} description={description} image={image} imageAlt={imageAlt} spine={label}>
  <SiteHeader slot="chrome" />

  <slot />

  <Fragment slot="close">
    {hideBooking ? <div class="mt-32 sm:mt-48" /> : <BookingBand />}
  </Fragment>

  <Fragment slot="scripts">
    <script>
      import '@/scripts/motion';
      import '@/scripts/film';
      import '@/scripts/rooms';
    </script>
  </Fragment>
</Document>
