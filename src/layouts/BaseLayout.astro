---
import { Font } from 'astro:assets';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import BookingBand from '@/components/BookingBand.astro';
import { site } from '@/data/site';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** `light-gallery` switches the page to the white-cube exhibition palette. */
  theme?: 'dark' | 'light-gallery';
  /** Hide the closing booking band (used on /book itself). */
  hideBooking?: boolean;
}

const { title, description = site.description, theme = 'dark', hideBooking = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.artist}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme={theme === 'light-gallery' ? 'light-gallery' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={theme === 'light-gallery' ? '#FDFCFA' : '#0B0B0D'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Self-hosted fonts with size-adjusted fallbacks. Every face visible
         above the fold is preloaded (Latin subset only), including the
         Newsreader italic used for the hero headline. -->
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />
  </head>
  <body>
    <a href="#main" class="skip-link text-meta">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    {hideBooking ? <div class="mt-32 sm:mt-48" /> : <BookingBand />}
    <SiteFooter />
  </body>
</html>
