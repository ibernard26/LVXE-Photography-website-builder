---
import { Font, getImage } from 'astro:assets';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/data/site';
import ogSource from '@/assets/images/portfolio/red-motion-portrait.jpg';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** `light-gallery` switches the page to the white-cube exhibition palette. */
  theme?: 'dark' | 'light-gallery';
  /** Set true on pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
  /** Hide the site header at lg+ because the page supplies its own masthead (Curatorial Split). */
  splitChrome?: boolean;
}

const { title, description = site.description, theme = 'dark', noindex = false, splitChrome = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.artist}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const og = await getImage({ src: ogSource, width: Math.min(1200, ogSource.width), format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.artist,
  jobTitle: 'Photographer',
  brand: { '@type': 'Brand', name: site.name },
  url: Astro.site?.toString(),
  email: `mailto:${site.contact.email}`,
  sameAs: [site.contact.instagramUrl, site.contact.archiveUrl],
  contactPoint: { '@type': 'ContactPoint', contactType: 'bookings', email: site.contact.email, url: new URL('/inquire', Astro.site).toString() },
};
---

<!doctype html>
<html lang="en" data-theme={theme === 'light-gallery' ? 'light-gallery' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={theme === 'light-gallery' ? '#FDFCFA' : '#0B0B0D'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content="Portrait dissolved by horizontal red motion blur, one eye held sharp." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Font cssVariable="--font-newsreader" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />
  </head>
  <body>
    <a href="#main" class="skip-link text-meta">Skip to content</a>
    <div class:list={[splitChrome && 'lg:hidden']}><SiteHeader /></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
