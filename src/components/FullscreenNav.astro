---
/**
 * Full-screen navigation, styled as the issue's table of contents.
 * Opening: the panel wipes down (600ms), then index rows rise in sequence
 * (500ms, +60ms each). Closing reverses. While open, everything else is
 * `inert`, focus starts on the first link, Esc closes and focus returns to
 * the toggle. Reduced motion: instant.
 */
import { issue, navigation, site } from '@/data/site';
import { series } from '@/data/series';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const pad = (n: number) => String(n).padStart(2, '0');
---

<div
  id="site-menu"
  class="menu fixed inset-0 z-[70] overflow-y-auto bg-obsidian text-bone"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  hidden
>
  <div class="mx-auto flex min-h-full max-w-screen-2xl flex-col px-gutter py-5">
    <div class="flex items-center justify-between">
      <span class="text-meta">Contents — Issue {issue.number}</span>
      <button type="button" class="text-meta cursor-pointer bg-transparent p-0 text-bone" data-menu-close>
        Close
      </button>
    </div>

    <nav aria-label="Primary" class="mt-16 flex-1 sm:mt-24">
      <ol class="border-t border-border">
        {
          navigation.map((item, i) => {
            const current = isCurrent(item.href);
            return (
              <li class="menu-row border-b border-border" style={`--i:${i}`}>
                <a
                  href={item.href}
                  aria-current={current ? 'page' : undefined}
                  class:list={['group grid grid-cols-[3rem_minmax(0,1fr)] items-baseline gap-x-4 py-4 sm:grid-cols-[6rem_minmax(0,1fr)_auto] sm:py-5', current && 'is-active']}
                >
                  <span class:list={['text-meta', item.accent && 'text-bone']}>{pad(i + 1)}</span>
                  <span class="min-w-0">
                    <span class="block font-serif text-[clamp(2.75rem,9vw,8rem)] font-[400] leading-[0.95] tracking-[-0.02em] transition-transform duration-500 ease-editorial group-hover:translate-x-3">
                      {item.label}
                    </span>
                    <span class="rule-grow mt-3 w-24" aria-hidden="true"></span>
                  </span>
                  <span class="text-meta col-start-2 mt-2 sm:col-start-auto sm:mt-0">{item.note}</span>
                </a>
              </li>
            );
          })
        }
      </ol>
    </nav>

    <div class="menu-row mt-16 grid gap-8 sm:grid-cols-3" style="--i:5">
      <div>
        <p class="text-meta text-bone">Practice</p>
        <p class="text-body mt-3">{site.disciplines.join(', ')}.</p>
      </div>
      <div>
        <p class="text-meta text-bone">Series</p>
        <ul class="mt-3">
          {series.map((s) => <li class="text-heading text-[1.25rem]">{s.title}</li>)}
        </ul>
      </div>
      <div>
        <p class="text-meta text-bone">Region</p>
        <p class="text-body mt-3">{site.region}</p>
      </div>
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .menu {
      clip-path: inset(0 0 100% 0);
      transition: clip-path 600ms var(--ease-cine);
    }
    .menu.is-open {
      clip-path: inset(0 0 0 0);
    }
    .menu-row {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 500ms var(--ease-editorial),
        transform 500ms var(--ease-cine);
    }
    .menu.is-open .menu-row {
      opacity: 1;
      transform: none;
      transition-delay: calc(240ms + var(--i, 0) * 60ms);
    }
  }
</style>

<script>
  const DURATION = 600;
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setup() {
    const menu = document.getElementById('site-menu');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    if (!menu || !toggle || menu.dataset.ready) return;
    menu.dataset.ready = 'true';

    const others = () => Array.from(document.body.children).filter((el) => el !== menu) as HTMLElement[];

    const open = () => {
      menu.hidden = false;
      others().forEach((el) => (el.inert = true));
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        menu.classList.add('is-open');
        menu.querySelector<HTMLElement>('nav a')?.focus();
      });
    };

    const close = (returnFocus = true) => {
      menu.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      others().forEach((el) => (el.inert = false));
      document.documentElement.style.overflow = '';
      window.setTimeout(() => (menu.hidden = true), reduce() ? 0 : DURATION);
      if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', open);
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => close());
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    // Following a link: release the page before the router swaps it.
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close(false)));
  }

  document.addEventListener('astro:page-load', setup);
</script>
