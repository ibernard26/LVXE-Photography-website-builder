---
/** Progressive support for ?view=vault: forwards to the prerendered vault route. */
---
<script is:inline>
  (() => {
    const q = new URLSearchParams(location.search);
    if (q.get('view') === 'vault') {
      const cat = location.pathname.match(/\/portfolio\/category\/([a-z]+)/)?.[1];
      location.replace(cat ? `/portfolio/vault/category/${cat}` : '/portfolio/vault');
    }
  })();
</script>
