---
/**
 * Plate — the single image primitive for the whole site.
 *
 * Integrity rules (README §2.2):
 *  - Only `widths` are passed to the optimiser, never a target height, so
 *    every derivative is a proportional resize of the original frame.
 *  - The rendered <img> carries the intrinsic width/height attributes and is
 *    sized with `width: 100%; height: auto` — the browser reserves the exact
 *    native-ratio box before the file arrives (zero CLS). No object-fit.
 */
import { Picture } from 'astro:assets';
import type { Plate } from '@/data/plates';

interface Props {
  plate: Plate;
  /** Responsive `sizes` attribute describing the plate's rendered width. */
  sizes: string;
  /** Visible plate number, e.g. "01". */
  index?: string;
  /** Set on the single LCP image only. */
  priority?: boolean;
  class?: string;
}

const { plate, sizes, index, priority = false, class: className } = Astro.props;

const nativeWidth = plate.image.width;
const candidateWidths = [480, 720, 960, 1280, 1600, 2000, 2400];
// Never upscale: cap derivatives at the master's own width.
const widths = [...candidateWidths.filter((w) => w < nativeWidth), nativeWidth];
---

<figure class:list={['plate', className]}>
  <Picture
    src={plate.image}
    alt={plate.alt}
    widths={widths}
    sizes={sizes}
    formats={['webp']}
    fallbackFormat="jpg"
    quality={82}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class="w-full h-auto bg-charcoal"
  />
  {
    (index || plate.caption) && (
      <figcaption class="text-meta mt-3 flex gap-4">
        {index && <span aria-hidden="true">{index}</span>}
        {plate.caption && <span>{plate.caption}</span>}
      </figcaption>
    )
  }
</figure>
