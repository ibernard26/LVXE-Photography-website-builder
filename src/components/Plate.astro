---
/**
 * Plate: the single image primitive.
 *  - variant "full" (default): proportional resize only, intrinsic width/height,
 *    width:100%/height:auto, NO object-fit. Charcoal background while loading.
 *  - variant "thumb": the one sanctioned exception (grid/index thumbnails only),
 *    a fixed frame from tailwind.config.mjs aspectRatio with object-fit: cover.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  caption?: string;
  index?: string;
  priority?: boolean;
  variant?: 'full' | 'thumb';
  thumbAspect?: '4/5' | '3/2' | '2/3' | '16/9';
  class?: string;
  id?: string;
}

const {
  image, alt, sizes, caption, index, priority = false,
  variant = 'full', thumbAspect = '4/5', class: className, id,
} = Astro.props;

const candidateWidths = [480, 720, 960, 1280, 1600, 2000, 2400];
const widths = [...candidateWidths.filter((w) => w < image.width), image.width]; // never upscale

const thumbFrame = {
  '4/5': 'aspect-4/5', '3/2': 'aspect-3/2', '2/3': 'aspect-2/3', '16/9': 'aspect-16/9',
}[thumbAspect];
const imgClass = variant === 'thumb'
  ? `w-full h-auto ${thumbFrame} object-cover bg-charcoal`
  : 'w-full h-auto bg-charcoal';
---

<figure id={id} class:list={['plate', className]}>
  <div class="bg-charcoal">
  <Picture
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={80}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class={imgClass}
  />
  </div>
  {
    (index || caption) && (
      <figcaption class="text-meta mt-3 flex gap-4">
        {index && <span aria-hidden="true">{index}</span>}
        {caption && <span>{caption}</span>}
      </figcaption>
    )
  }
</figure>
