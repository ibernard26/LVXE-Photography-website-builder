---
/**
 * Closing booking spread on every page except /book. Two doors: a portrait
 * session or a commercial brief — the corporate path is never buried.
 */
import { site } from '@/data/site';
---

<aside aria-labelledby="booking-band" class="mt-32 bg-charcoal sm:mt-48">
  <div class="mx-auto grid max-w-screen-2xl gap-y-10 px-gutter py-16 sm:py-24 lg:grid-cols-12 lg:gap-x-8">
    <div class="lg:col-span-7">
      <p class="text-meta">Bookings — {site.region}</p>
      <h2 id="booking-band" class="reveal-lines mt-6">
        <span class="line-mask"><span class="text-display" style="--i:0">Book a</span></span>
        <span class="line-mask"><span class="text-display-serif pl-[0.6em]" style="--i:1">session.</span></span>
      </h2>
    </div>
    <ul class="grid content-end gap-y-px self-end lg:col-span-5">
      <li>
        <a href="/book?type=portrait" class="group flex items-baseline justify-between gap-6 border-t border-soft-gray/30 py-5">
          <span class="text-heading">Portrait &amp; editorial</span>
          <span class="text-meta link-book">Start</span>
        </a>
      </li>
      <li>
        <a href="/book?type=commercial" class="group flex items-baseline justify-between gap-6 border-y border-soft-gray/30 py-5">
          <span class="text-heading">Commercial &amp; corporate</span>
          <span class="text-meta link-book">Brief</span>
        </a>
      </li>
    </ul>
  </div>
</aside>
