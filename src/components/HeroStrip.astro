---
/**
 * Homepage hero — a full-bleed contact strip.
 *
 * Three real frames sit edge to edge at their native 2:3 ratio (three
 * portraits = a 2:1 strip across 100vw), so the hero is full-bleed without
 * cropping a single frame. On phones: one full-width frame, then a pair.
 *
 * Opening sequence (≈1.6s): the oversized wordmark rises letter by letter,
 * the frames unveil top-down (800ms, +120ms) and the darkroom light lifts
 * the strip out of black. The wordmark's feet overlap the strip's top edge
 * in `mix-blend-mode: difference`, away from the sitters' faces.
 *
 * Layers: frames → darkroom (WebGL canvas, or CSS veil fallback) → wordmark.
 */
import Plate from '@/components/Plate.astro';
import { frameOf, heroPlates, plateNumber } from '@/data/plates';
import { issue, site } from '@/data/site';

const letters = site.name.split('');
---

<section aria-labelledby="hero-wordmark" class="relative">
  <div class="mx-auto flex max-w-screen-2xl flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-gutter pt-4">
    <p class="text-meta reveal-fade" style="--i:5">{site.artist} — Photography &amp; visual art</p>
    <p class="text-meta reveal-fade hidden sm:block" style="--i:6">{site.disciplines.join(' / ')}</p>
  </div>

  <!-- Oversized wordmark. Its feet bite into the strip's upper edge (hair,
       sky, stone) in difference blend; it never sits over a face. -->
  <h1
    id="hero-wordmark"
    class="reveal-lines text-mega relative z-10 -mb-[0.2em] flex px-[1vw] text-[40vw] text-bone mix-blend-difference"
    aria-label={site.name}
  >
    {
      letters.map((ch, i) => (
        <span class="line-mask" aria-hidden="true">
          <span style={`--i:${i + 2}`}>{ch}</span>
        </span>
      ))
    }
  </h1>

  <div class="relative" data-darkroom>
    <div class="grid grid-cols-2 md:grid-cols-3">
      {
        heroPlates.map((plate, i) => (
          <Plate
            plate={plate}
            i={i}
            priority={i === 0}
            href={`/work/${plate.id}`}
            sizes={i === 0 ? '(min-width: 768px) 34vw, 100vw' : '(min-width: 768px) 34vw, 50vw'}
            class={i === 0 ? 'col-span-2 md:col-span-1' : ''}
          />
        ))
      }
    </div>

    <!-- CSS fallback veil: follows a fine pointer; static vignette otherwise. -->
    <div class="hero-veil pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <canvas class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true" hidden></canvas>

    <!-- Contact-strip edge print along the bottom of the frames. -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 hidden grid-cols-3 md:grid" aria-hidden="true">
      {
        heroPlates.map((plate) => (
          <p class="text-meta px-4 py-3 text-bone/80 mix-blend-difference">
            {plateNumber(plate)} ▸ {plate.tone} · {frameOf(plate).ratio} · Issue {issue.number}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-veil {
    background: radial-gradient(
      circle at var(--mx, 50%) var(--my, 45%),
      rgb(11 11 13 / 0.06) 0,
      rgb(11 11 13 / 0.38) 60%
    );
  }
  :global(.has-gl) .hero-veil {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-veil {
      animation: develop 1600ms cubic-bezier(0.2, 0, 0, 1) both;
    }
  }
  @keyframes develop {
    from {
      background-color: rgb(11 11 13 / 0.92);
    }
    to {
      background-color: rgb(11 11 13 / 0);
    }
  }
</style>

<script>
  let cleanup: (() => void) | null = null;

  async function boot() {
    const host = document.querySelector<HTMLElement>('[data-darkroom]');
    if (!host) return;
    const canvas = host.querySelector('canvas')!;
    const veil = host.querySelector<HTMLElement>('.hero-veil')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (!reduce && !saveData) {
      try {
        const { startDarkroom } = await import('@/scripts/darkroom');
        cleanup = startDarkroom(host, canvas);
      } catch {
        cleanup = null;
      }
      if (cleanup) {
        canvas.hidden = false;
        host.classList.add('has-gl');
        return;
      }
    }

    // Fallback: CSS veil tracks a fine pointer.
    if (!reduce && fine) {
      const move = (e: PointerEvent) => {
        const r = host.getBoundingClientRect();
        veil.style.setProperty('--mx', `${e.clientX - r.left}px`);
        veil.style.setProperty('--my', `${e.clientY - r.top}px`);
      };
      host.addEventListener('pointermove', move);
      cleanup = () => host.removeEventListener('pointermove', move);
    }
  }

  document.addEventListener('astro:page-load', boot);
  // Release the GPU as soon as a navigation starts, so the transition
  // snapshot doesn't compete with the darkroom loop.
  const stop = () => {
    cleanup?.();
    cleanup = null;
  };
  document.addEventListener('astro:before-preparation', stop);
  document.addEventListener('astro:before-swap', stop);
</script>
