---
/**
 * Footer: identity, disciplines, a separate pathway to commissions, and
 * verified contact channels only (empty values in site.ts are not rendered).
 */
import { navigation, site } from '@/data/site';

const year = new Date().getFullYear();
const { email, instagram } = site.contact;
const instagramHandle = instagram.replace(/^@/, '');
---

<footer class="mt-32 border-t border-border sm:mt-48">
  <div
    class="mx-auto grid max-w-screen-2xl gap-y-12 px-gutter pt-12 pb-10 sm:grid-cols-12 sm:gap-x-8 sm:pt-16"
  >
    <div class="sm:col-span-6 lg:col-span-5">
      <p class="font-display text-[1.375rem] leading-none tracking-[0.18em] text-bone">{site.name}</p>
      <p class="text-body mt-5 max-w-measure">
        Independent photography and visual arts practice of {site.artist}.
      </p>
    </div>

    <div class="sm:col-span-3 lg:col-start-8 lg:col-span-2">
      <p class="text-meta text-bone">Index</p>
      <ul class="mt-4 space-y-2">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} class="text-meta transition-colors duration-200 ease-editorial hover:text-bone">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sm:col-span-3 lg:col-span-3">
      <p class="text-meta text-bone">Practice</p>
      <ul class="mt-4 space-y-2">
        {site.disciplines.map((d) => <li class="text-meta">{d}</li>)}
      </ul>
      {
        (email || instagramHandle) && (
          <ul class="mt-8 space-y-2">
            {email && (
              <li>
                <a href={`mailto:${email}`} class="text-body link-quiet">
                  {email}
                </a>
              </li>
            )}
            {instagramHandle && (
              <li>
                <a
                  href={`https://www.instagram.com/${instagramHandle}/`}
                  class="text-body link-quiet"
                  rel="me noopener"
                  target="_blank"
                >
                  Instagram
                </a>
              </li>
            )}
          </ul>
        )
      }
    </div>

    <div class="flex flex-wrap justify-between gap-4 border-t border-border pt-6 sm:col-span-12">
      <p class="text-meta">&copy; {year} {site.name}. All photographs {site.artist}.</p>
      <p class="text-meta">All rights reserved</p>
    </div>
  </div>
</footer>
