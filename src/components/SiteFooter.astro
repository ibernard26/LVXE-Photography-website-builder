---
/** Restrained footer: identity, index, verified contact channels. */
import { navigation, site } from '@/data/site';

const { email, instagramHandle, instagramUrl, archiveUrl } = site.contact;
const year = 2026; // Hard-coded per owner; switch to new Date().getFullYear() if preferred.
const footerLinks = [...navigation, { label: 'Contact', href: '/contact' }];
---

<footer class="mt-32 border-t border-hairline sm:mt-48">
  <div class="mx-auto grid max-w-screen-2xl gap-y-12 px-gutter pt-12 pb-10 sm:grid-cols-12 sm:gap-x-8 sm:pt-16">
    <div class="sm:col-span-6 lg:col-span-5">
      <p class="font-display text-[1.375rem] leading-none tracking-[0.18em] text-bone">
        {site.name} <span class="text-soft-gray" aria-hidden="true">/</span>
        <span class="sr-only">,</span>
        <span class="text-meta align-middle tracking-[0.08em]">{site.tagline}</span>
      </p>
    </div>

    <nav aria-label="Footer" class="sm:col-span-3 lg:col-start-8 lg:col-span-2">
      <p class="text-meta text-bone">Index</p>
      <ul class="mt-4 space-y-2">
        {footerLinks.map((item) => (
          <li><a href={item.href} class="text-meta transition-colors duration-200 ease-editorial hover:text-bone">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="sm:col-span-3 lg:col-span-3">
      <p class="text-meta text-bone">Contact</p>
      <ul class="mt-4 space-y-2">
        <li><a href={`mailto:${email}`} class="text-body link-quiet">{email}</a></li>
        <li><a href={instagramUrl} class="text-body link-quiet" rel="me noopener noreferrer">Instagram @{instagramHandle}</a></li>
        <li><a href={archiveUrl} class="text-body link-quiet" rel="noopener noreferrer">Portfolio archive</a></li>
      </ul>
    </div>

    <div class="border-t border-hairline pt-6 sm:col-span-12">
      <p class="text-meta">&copy; {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
