---
/**
 * Colophon. Verified contact channels only (empty values are not rendered).
 */
import { issue, navigation, site } from '@/data/site';

const year = new Date().getFullYear();
const { email, instagram } = site.contact;
const instagramHandle = instagram.replace(/^@/, '');
---

<footer class="border-t border-border">
  <div class="mx-auto grid max-w-screen-2xl gap-y-12 px-gutter pt-14 pb-8 sm:grid-cols-12 sm:gap-x-8">
    <div class="sm:col-span-6">
      <p class="text-meta">Colophon — Issue {issue.number}</p>
      <p class="text-heading mt-6 max-w-[22ch]">
        An independent photography and visual arts practice by {site.artist}.
      </p>
    </div>

    <div class="sm:col-span-3">
      <p class="text-meta text-bone">Contents</p>
      <ul class="mt-4 space-y-2">
        {
          navigation.map((item, i) => (
            <li>
              <a href={item.href} class="text-meta transition-colors duration-300 ease-editorial hover:text-bone">
                <span class="text-bone">{String(i + 1).padStart(2, '0')}</span> {item.label}
                {item.note && <span> ({item.note})</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sm:col-span-3">
      <p class="text-meta text-bone">Practice</p>
      <ul class="mt-4 space-y-2">
        {site.disciplines.map((d) => <li class="text-meta">{d}</li>)}
        <li class="text-meta pt-2">{site.region}</li>
      </ul>
      {
        (email || instagramHandle) && (
          <ul class="mt-8 space-y-2">
            {email && (
              <li>
                <a href={`mailto:${email}`} class="text-body link-quiet">
                  {email}
                </a>
              </li>
            )}
            {instagramHandle && (
              <li>
                <a href={`https://www.instagram.com/${instagramHandle}/`} class="text-body link-quiet" rel="me noopener" target="_blank">
                  Instagram
                </a>
              </li>
            )}
          </ul>
        )
      }
    </div>

    <p
      aria-hidden="true"
      class="text-mega col-span-full -mb-[0.12em] select-none text-charcoal sm:mt-8"
    >
      {site.name}
    </p>

    <div class="col-span-full flex flex-wrap justify-between gap-4 border-t border-border pt-6">
      <p class="text-meta">&copy; {year} {site.name}. All photographs {site.artist}.</p>
      <p class="text-meta">All rights reserved</p>
    </div>
  </div>
</footer>
