---
import type { CollectionEntry } from 'astro:content';
import Plate from '@/components/Plate.astro';

interface Props { project: CollectionEntry<'projects'>; flip?: boolean }
const { project, flip = false } = Astro.props;
const [a, b] = project.data.images;
---

<article class="grid grid-cols-6 gap-x-4 lg:grid-cols-12 lg:gap-x-8">
  <header class:list={['col-span-6 mb-8 lg:mb-0 lg:col-span-3 lg:row-start-1', flip ? 'lg:col-start-10' : 'lg:col-start-1']}>
    <p class="text-meta">{project.data.category} / {project.data.year}{project.data.sample && ' / sample'}</p>
    <h3 class="text-heading mt-3">
      <a href={`/portfolio/${project.id}`} class="link-quiet">{project.data.title}</a>
    </h3>
  </header>
  {a && (
    <Plate image={a.src} alt={a.alt} caption={a.caption}
      sizes="(min-width: 1024px) 40vw, 100vw"
      class:list={['col-span-6 lg:col-span-5 lg:row-start-1', flip ? 'lg:col-start-1' : 'lg:col-start-4']} />
  )}
  {b && (
    <Plate image={b.src} alt={b.alt} caption={b.caption}
      sizes="(min-width: 1024px) 28vw, 66vw"
      class:list={['col-span-4 col-start-3 mt-10 lg:col-span-3 lg:row-start-1 lg:mt-32', flip ? 'lg:col-start-6' : 'lg:col-start-10']} />
  )}
</article>
