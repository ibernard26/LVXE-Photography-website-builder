---
/**
 * Homepage editorial hero.
 *
 * Layout: an asymmetric 12-column composition (6 columns on mobile). The
 * plates differ in scale and offset, not in shape — each keeps its native
 * frame via <Plate>. Nothing here sets a height, aspect-ratio or object-fit
 * on an image.
 *
 *   lg ┌──────────┬─┬──────────────────┐
 *      │ copy     │ │                  │
 *      ├──┬─────┬─┤ │  lead plate      │
 *      │  │ 02  │   │                  │
 *      │  │     │   └──────────────────┘
 *      │  └─────┘           ┌──────┐
 *      │                    │ 03   │
 */
import Plate from '@/components/Plate.astro';
import { heroPlates } from '@/data/plates';
import { site } from '@/data/site';

const [lead, second, third] = heroPlates;
---

<section aria-labelledby="hero-title" class="mx-auto max-w-screen-2xl px-gutter">
  <div class="grid grid-cols-6 gap-x-4 lg:grid-cols-12 lg:gap-x-8">
    <!-- Proposition -->
    <div
      class="col-span-6 pt-16 pb-14 sm:pt-24 lg:col-span-5 lg:row-start-1 lg:pt-32 lg:pb-0 xl:col-span-4"
    >
      <ul class="text-meta flex flex-wrap gap-x-3 gap-y-1" aria-label="Disciplines">
        {
          site.disciplines.map((d, i) => (
            <li class="whitespace-nowrap">
              {i > 0 && <span aria-hidden="true" class="mr-3">/</span>}
              {d}
            </li>
          ))
        }
      </ul>

      <h1 id="hero-title" class="text-display mt-8 max-w-[12ch]" data-draft={site.slogan.draft || undefined}>
        {site.slogan.text}
      </h1>

      <p class="text-body mt-8 max-w-[34ch]" data-draft={site.proposition.draft || undefined}>
        {site.proposition.text}
      </p>

      <ul class="mt-12 flex flex-wrap gap-x-10 gap-y-4">
        <li>
          <a href="/work" class="text-meta link-quiet text-bone">View the work</a>
        </li>
        <li>
          <a href="/commissions" class="text-meta link-quiet">Commissions</a>
        </li>
      </ul>
    </div>

    <!-- Lead plate — the LCP element -->
    <Plate
      plate={lead}
      index="01"
      priority
      sizes="(min-width: 1536px) 860px, (min-width: 1024px) 56vw, 100vw"
      class="col-span-6 lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1 lg:pt-16 xl:col-span-7 xl:col-start-6"
    />

    <!-- Second plate — smaller, inset beneath the copy -->
    <Plate
      plate={second}
      index="02"
      sizes="(min-width: 1536px) 340px, (min-width: 1024px) 22vw, 66vw"
      class="col-span-4 mt-16 lg:col-span-3 lg:col-start-2 lg:row-start-2 lg:mt-40 lg:self-start"
    />

    <!-- Third plate — trails the lead, pushed off its axis -->
    <Plate
      plate={third}
      index="03"
      sizes="(min-width: 1536px) 340px, (min-width: 1024px) 22vw, 66vw"
      class="col-span-4 col-start-3 mt-16 lg:col-span-3 lg:col-start-9 lg:row-start-3 lg:mt-24"
    />
  </div>
</section>
