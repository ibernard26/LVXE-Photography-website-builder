---
/**
 * Masthead rail: wordmark, issue line, booking link and the menu toggle.
 * Thin, mono, static (no sticky blur bar). Navigation lives in the
 * full-screen menu; Book stays one tap away in the rail.
 */
import { issue, site } from '@/data/site';
---

<header class="relative z-40">
  <div
    class="mx-auto grid max-w-screen-2xl grid-cols-[1fr_auto] items-center gap-x-6 px-gutter py-5 md:grid-cols-[1fr_auto_1fr]"
  >
    <a href="/" class="hit-target flex items-baseline gap-4">
      <span class="font-sans text-[1.0625rem] font-[750] leading-none tracking-[-0.04em] text-bone">
        {site.name}<span class="text-burgundy">.</span>
      </span>
      <span class="text-meta hidden sm:inline">Issue {issue.number} — {issue.year}</span>
      <span class="sr-only">, home</span>
    </a>

    <p class="text-meta hidden text-center md:block">{site.region}</p>

    <div class="flex items-center justify-end gap-6 sm:gap-8">
      <a href="/book" class="text-meta link-book hidden sm:inline">Book</a>
      <button
        type="button"
        class="text-meta group flex cursor-pointer items-center gap-3 bg-transparent p-0 text-bone"
        aria-controls="site-menu"
        aria-expanded="false"
        data-menu-open
      >
        <span>Menu</span>
        <span aria-hidden="true" class="flex w-6 flex-col gap-[5px]">
          <span class="block h-px w-full bg-bone transition-transform duration-300 ease-editorial group-hover:scale-x-75 origin-right"></span>
          <span class="block h-px w-full bg-bone"></span>
        </span>
      </button>
    </div>
  </div>
</header>
